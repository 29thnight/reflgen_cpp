<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 패키지의 build\native\reflgen.targets. 패키지를 설치하면 NuGet 이 이 파일을 프로젝트에 Import 한다
  (Microsoft.Cpp.targets 다음의 ExtensionTargets 자리 — reflgen.targets 가 요구하는 위치다).

  패키지는 cmake 설치 배치(include\ bin\ share\reflgen\msbuild\)를 그대로 담는다. 여기서는 진짜 targets 를
  가져오기만 한다 — 생성기와 include 디렉터리는 그쪽이 설치 배치에서 스스로 찾는다.
-->
<Project>
  <Import Project="$(MSBuildThisFileDirectory)..\..\share\reflgen\msbuild\reflgen.targets" />
</Project>
