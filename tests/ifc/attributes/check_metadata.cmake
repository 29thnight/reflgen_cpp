file(MAKE_DIRECTORY "${WORK}")
set(args --ifc "${IFC}" --import reflgen.test.annotated --module validated --output "${WORK}"
    --attribute-scope editor --attribute-import reflgen.test.attributes)
execute_process(COMMAND "${GENERATOR}" ${args} --metadata "${METADATA}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "valid metadata rejected: ${error}")
endif()
file(READ "${WORK}/reflgen_validated.h" before)
file(READ "${WORK}/reflgen_validated.attributes.tsv" catalog)
if(NOT catalog MATCHES "editor\ttooltip\ttooltip\(\.\.\.\)")
    message(FATAL_ERROR "module user attribute was not published to VS completion catalog")
endif()
file(READ "${METADATA}" text)
foreach(problem IN ITEMS module declaration raw)
    if(problem STREQUAL module)
        string(REPLACE "reflgen.test.annotated" "wrong.module" invalid "${text}")
    elseif(problem STREQUAL declaration)
        string(REPLACE "actor" "renamed_actor" invalid "${text}")
    else()
        set(invalid "export module reflgen.test.annotated;\n")
    endif()
    file(WRITE "${WORK}/bad.i" "${invalid}")
    execute_process(COMMAND "${GENERATOR}" ${args} --metadata "${WORK}/bad.i"
        RESULT_VARIABLE result ERROR_VARIABLE error)
    if(result EQUAL 0 OR NOT error MATCHES "RG0200")
        message(FATAL_ERROR "invalid ${problem} metadata accepted: ${error}")
    endif()
    file(READ "${WORK}/reflgen_validated.h" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "failed metadata extraction replaced a valid schema")
    endif()
endforeach()
# Copying then touching an IFC simulates compiling a newer binary without refreshing its sidecar.
file(COPY_FILE "${IFC}" "${WORK}/newer.ifc")
execute_process(COMMAND "${CMAKE_COMMAND}" -E touch "${WORK}/newer.ifc")
execute_process(COMMAND "${GENERATOR}" --ifc "${WORK}/newer.ifc" --import reflgen.test.annotated
    --module stale --output "${WORK}" --metadata "${METADATA}" RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "metadata predates IFC" OR EXISTS "${WORK}/reflgen_stale.h")
    message(FATAL_ERROR "stale metadata accepted: ${error}")
endif()
