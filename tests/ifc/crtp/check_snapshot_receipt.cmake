# Experiment only: compile against a private IFC snapshot and verify a receipt.
# This is not an authentication mechanism and does not protect against a process
# that can modify the snapshot or receipt during compilation.
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${COMPILER}" /nologo /std:c++20 /EHsc /interface /c "${SOURCE}/imported_base.ixx"
    /ifcOutput "${WORK}/base.ifc" "/Fo${WORK}/base.obj"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "base compile failed: ${out}${err}")
endif()
file(COPY_FILE "${WORK}/base.ifc" "${WORK}/snapshot.ifc" ONLY_IF_DIFFERENT)
file(SHA256 "${WORK}/snapshot.ifc" before)
execute_process(COMMAND "${COMPILER}" /nologo /std:c++20 /EHsc /interface /c "${SOURCE}/imported_user.ixx"
    /reference "reflgen.test.imported_base=${WORK}/snapshot.ifc"
    /ifcOutput "${WORK}/user.ifc" "/Fo${WORK}/user.obj"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "consumer compile failed: ${out}${err}")
endif()
file(SHA256 "${WORK}/snapshot.ifc" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "snapshot changed during compilation")
endif()
file(SHA256 "${WORK}/user.ifc" consumer_hash)
file(WRITE "${WORK}/receipt.txt" "${before}\n${consumer_hash}\n")

function(receipt_matches out snapshot consumer receipt)
    file(STRINGS "${receipt}" expected)
    list(LENGTH expected count)
    if(NOT count EQUAL 2 OR NOT EXISTS "${snapshot}" OR NOT EXISTS "${consumer}")
        set(${out} FALSE PARENT_SCOPE)
        return()
    endif()
    list(GET expected 0 expected_base)
    list(GET expected 1 expected_consumer)
    file(SHA256 "${snapshot}" actual_base)
    file(SHA256 "${consumer}" actual_consumer)
    if(actual_base STREQUAL expected_base AND actual_consumer STREQUAL expected_consumer)
        set(${out} TRUE PARENT_SCOPE)
    else()
        set(${out} FALSE PARENT_SCOPE)
    endif()
endfunction()

receipt_matches(ok "${WORK}/snapshot.ifc" "${WORK}/user.ifc" "${WORK}/receipt.txt")
if(NOT ok)
    message(FATAL_ERROR "unchanged files must match receipt")
endif()
file(APPEND "${WORK}/snapshot.ifc" "changed")
receipt_matches(ok "${WORK}/snapshot.ifc" "${WORK}/user.ifc" "${WORK}/receipt.txt")
if(ok)
    message(FATAL_ERROR "modified provider IFC must be rejected")
endif()
file(COPY_FILE "${WORK}/base.ifc" "${WORK}/snapshot.ifc")
file(APPEND "${WORK}/user.ifc" "changed")
receipt_matches(ok "${WORK}/snapshot.ifc" "${WORK}/user.ifc" "${WORK}/receipt.txt")
if(ok)
    message(FATAL_ERROR "modified consumer IFC must be rejected")
endif()
