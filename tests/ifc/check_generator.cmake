file(MAKE_DIRECTORY "${WORK}")
set(args --ifc "${IFC}" --import reflgen.test.types --module checked --output "${WORK}")
execute_process(COMMAND "${GENERATOR}" ${args} RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "IFC generation failed: ${log}${error}")
endif()
file(READ "${WORK}/reflgen_checked.h" before)
file(TIMESTAMP "${WORK}/reflgen_checked.h" time_before "%s")
execute_process(COMMAND "${GENERATOR}" ${args} RESULT_VARIABLE result)
file(TIMESTAMP "${WORK}/reflgen_checked.h" time_after "%s")
if(NOT result EQUAL 0 OR NOT time_before STREQUAL time_after)
    message(FATAL_ERROR "unchanged IFC rewrote its generated header")
endif()
execute_process(COMMAND "${GENERATOR}" --ifc "${IFC}" --import wrong.module --module checked --output "${WORK}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "RG0200.*module mismatch")
    message(FATAL_ERROR "mismatched import did not fail: ${error}")
endif()
file(READ "${WORK}/reflgen_checked.h" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "failed generation replaced a valid header")
endif()
file(WRITE "${WORK}/invalid.ifc" "not an IFC")
execute_process(COMMAND "${GENERATOR}" --ifc "${WORK}/invalid.ifc" --import invalid --module invalid --output "${WORK}"
    RESULT_VARIABLE result ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "RG0200" OR EXISTS "${WORK}/reflgen_invalid.h")
    message(FATAL_ERROR "invalid IFC was accepted: ${error}")
endif()
message(STATUS "IFC generator: unchanged outputs, import mismatch, invalid file and failure preservation passed")
