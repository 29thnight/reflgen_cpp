<?xml version="1.0" encoding="utf-8"?>
<!-- MSBuild 연동 시험의 두 번째 라이브러리 — reflgen_msbuild_lib.vcxproj 와 서로의 header 를 include 한다. 이런 순환은
     ProjectReference 로 이을 수 없으므로 둘은 ReflgenReference 로 서로의 서술만 받는다: 빌드 순서를 걸지 않고, 상대의
     생성만 기다린다. 병렬 빌드(/m)에서 교착 없이, 생성은 프로젝트마다 한 번만 돌아야 한다(run_msbuild_test.cmake). -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{5A8D3C21-7F46-4E0B-B93D-1E6F2A7C4D95}</ProjectGuid>
    <RootNamespace>reflgen_msbuild_peer</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- run_msbuild_test.cmake 가 작업 디렉터리를 넘긴다 — 프로젝트마다 IntDir 를 따로 둔다. -->
  <PropertyGroup Condition="'$(ReflgenTestWork)' != ''">
    <OutDir>$(ReflgenTestWork)bin\</OutDir>
    <IntDir>$(ReflgenTestWork)obj\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <PropertyGroup>
    <ReflgenModule>msbuild_peer</ReflgenModule>
    <!-- 서술만 쓴다 — 등록 함수를 컴파일하지 않는다(run_msbuild_test.cmake 가 본다). -->
    <ReflgenRegistration>false</ReflgenRegistration>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <AdditionalOptions>/utf-8 /permissive- /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="peer_types.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="peer_types.h" />
  </ItemGroup>
  <ItemGroup>
    <ReflgenReference Include="reflgen_msbuild_lib.vcxproj" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="..\..\msbuild\reflgen.targets" />
</Project>
