<?xml version="1.0" encoding="utf-8"?>
<!-- MSBuild 연동 시험의 라이브러리 — reflgen_msbuild_test.vcxproj 가 ProjectReference 로 참조한다. 여기서 생성한
     서술(lib_types.h)을 참조하는 쪽이 강제 include 로 받아야 한다. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{0E3C1F7A-8D52-4B6E-9A41-5C7D2B9E3F18}</ProjectGuid>
    <RootNamespace>reflgen_msbuild_lib</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- run_msbuild_test.cmake 가 작업 디렉터리를 넘긴다 — 프로젝트마다 IntDir 를 따로 둔다. -->
  <PropertyGroup Condition="'$(ReflgenTestWork)' != ''">
    <OutDir>$(ReflgenTestWork)bin\</OutDir>
    <IntDir>$(ReflgenTestWork)obj\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <PropertyGroup>
    <ReflgenModule>msbuild_lib</ReflgenModule>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <AdditionalOptions>/utf-8 /permissive- /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="lib_types.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="lib_types.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="..\..\msbuild\reflgen.targets" />
</Project>
