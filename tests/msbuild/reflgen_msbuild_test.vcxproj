<?xml version="1.0" encoding="utf-8"?>
<!-- MSBuild 연동 시험 — msbuild/reflgen.targets 만 가져온 평범한 .vcxproj 가, 등록이나 include 없이 header 를
     찾아 생성·주입·컴파일까지 하는가. 미리 컴파일된 header(/Yu)를 쓰는 프로젝트다 — 주입이 pch 뒤에 와야 한다.
     reflgen_msbuild_lib.vcxproj 를 참조한다 — 그 프로젝트의 서술도 주입으로 받아야 하고(전파), 그 타입을 부모로 둔
     여기의 타입(derived_types.h)이 컴파일되려면 라이브러리의 주입이 여기 것보다 먼저 와야 한다.
     run_msbuild_test.cmake 가 ReflgenExecutable·ReflgenTestWork 를 넘겨 빌드한다. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6B0F2E53-4E5A-4A43-9C57-2B8C1D4F7A10}</ProjectGuid>
    <RootNamespace>reflgen_msbuild_test</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!-- run_msbuild_test.cmake 가 작업 디렉터리를 넘긴다 — 프로젝트마다 IntDir 를 따로 둔다. -->
  <PropertyGroup Condition="'$(ReflgenTestWork)' != ''">
    <OutDir>$(ReflgenTestWork)bin\</OutDir>
    <IntDir>$(ReflgenTestWork)obj\$(ProjectName)\</IntDir>
  </PropertyGroup>
  <PropertyGroup>
    <ReflgenModule>msbuild_test</ReflgenModule>
    <ReflgenAttributeScopes>generated_tests</ReflgenAttributeScopes>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <AdditionalOptions>/utf-8 /permissive- /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>..\generated;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="main.cpp" />
    <ClCompile Include="c_unit.c">
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\generated\game_types.h" />
    <ClInclude Include="derived_types.h" />
    <ClInclude Include="pch.h" />
    <ClInclude Include="plain.h" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="reflgen_msbuild_lib.vcxproj">
      <Project>{0E3C1F7A-8D52-4B6E-9A41-5C7D2B9E3F18}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="..\..\msbuild\reflgen.targets" />
</Project>
