# cmake -DCOMPILER=<compiler> -DWORK=<build directory> -DSUPPORTS_STD=ON/OFF -P check_matrix.cmake
foreach(required COMPILER WORK SUPPORTS_STD)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/matrix-results.txt" "")
function(run_checked)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(APPEND "${WORK}/matrix-build.log" "${output}\n${error}\n")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Failed (${result}): ${ARGV}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
foreach(standard IN ITEMS 20 23 26)
    foreach(backend IN ITEMS AUTO LEGACY)
        set(expected LEGACY)
        if(standard EQUAL 26 AND backend STREQUAL AUTO AND SUPPORTS_STD)
            set(expected STD)
        endif()
        set(directory "${WORK}/${standard}-${backend}")
        run_checked("${CMAKE_COMMAND}" -G Ninja -S "${CMAKE_CURRENT_LIST_DIR}/selection" -B "${directory}"
            "-DCMAKE_CXX_COMPILER=${COMPILER}" "-DTEST_STANDARD=${standard}"
            "-DTEST_BACKEND=${backend}" "-DTEST_EXPECTED=${expected}")
        run_checked("${CMAKE_COMMAND}" --build "${directory}" -j 2)
        run_checked("${CMAKE_CTEST_COMMAND}" --test-dir "${directory}" -V)
        string(REGEX MATCH "CPLUSPLUS=[^\r\n]*" features "${last_output}")
        file(APPEND "${WORK}/matrix-results.txt" "C++${standard} ${backend}: ${expected} ${features}\n")
        message(STATUS "C++${standard} ${backend}: ${expected} ${features}")
    endforeach()
endforeach()
if(SUPPORTS_STD)
    run_checked("${CMAKE_COMMAND}" -G Ninja -S "${CMAKE_CURRENT_LIST_DIR}/selection" -B "${WORK}/26-disabled"
        "-DCMAKE_CXX_COMPILER=${COMPILER}" -DTEST_STANDARD=26 -DTEST_BACKEND=LEGACY -DTEST_EXPECTED=LEGACY
        -DTEST_REFLECTION_FLAG=ON)
    run_checked("${CMAKE_COMMAND}" --build "${WORK}/26-disabled" -j 2)
    run_checked("${CMAKE_CTEST_COMMAND}" --test-dir "${WORK}/26-disabled" -V)
    if(NOT last_output MATCHES "HAS_STD=1 USE_STD=0")
        message(FATAL_ERROR "Supported standard reflection could not be disabled: ${last_output}")
    endif()
    file(APPEND "${WORK}/matrix-results.txt" "C++26 explicit opt-out with reflection available: HAS_STD=1 USE_STD=0\n")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -G Ninja -S "${CMAKE_CURRENT_LIST_DIR}/selection"
    -B "${WORK}/26-STD" "-DCMAKE_CXX_COMPILER=${COMPILER}" -DTEST_STANDARD=26 -DTEST_BACKEND=STD
    RESULT_VARIABLE forced OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(APPEND "${WORK}/matrix-build.log" "${output}\n${error}\n")
if(SUPPORTS_STD)
    if(NOT forced EQUAL 0)
        message(FATAL_ERROR "Forced STD failed: ${output}\n${error}")
    endif()
    run_checked("${CMAKE_COMMAND}" --build "${WORK}/26-STD" -j 2)
    run_checked("${CMAKE_CTEST_COMMAND}" --test-dir "${WORK}/26-STD" -V)
    set(forced_result "STD build/run passed")
else()
    if(forced EQUAL 0 OR NOT "${output}${error}" MATCHES "failed its compiler/library feature probe")
        message(FATAL_ERROR "Forced STD was not rejected by the capability probe: ${output}\n${error}")
    endif()
    set(forced_result "unsupported STD rejected")
endif()
message(STATUS "C++26 forced: ${forced_result}")
file(APPEND "${WORK}/matrix-results.txt" "C++26 forced: ${forced_result}\n")
get_filename_component(compiler_name "${COMPILER}" NAME)
foreach(standard IN ITEMS 20 23)
    if(compiler_name MATCHES "^cl(\\.exe)?$")
        if(standard EQUAL 23)
            set(mode /std:c++23preview)
        else()
            set(mode /std:c++20)
        endif()
        set(arguments /nologo /c ${mode} "/I${CMAKE_CURRENT_LIST_DIR}/../../include"
            "/Fo${WORK}/forced-${standard}.obj")
    else()
        set(arguments "-std=c++${standard}" -c "-I${CMAKE_CURRENT_LIST_DIR}/../../include"
            -o "${WORK}/forced-${standard}.o")
    endif()
    execute_process(COMMAND "${COMPILER}" ${arguments} "${CMAKE_CURRENT_LIST_DIR}/forced_features.cpp"
        RESULT_VARIABLE invalid OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(APPEND "${WORK}/matrix-build.log" "${output}\n${error}\n")
    if(invalid EQUAL 0 OR NOT "${output}${error}" MATCHES "requires C\\+\\+26")
        message(FATAL_ERROR "C++${standard} accepted an unavailable backend override: ${output}\n${error}")
    endif()
    file(APPEND "${WORK}/matrix-results.txt" "C++${standard} header override: rejected\n")
endforeach()
