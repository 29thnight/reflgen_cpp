#include <stdint.h>
#include "reflgen_scene_prsm.h"
#include "scene.h"
#include "scene_adapter.h"

int main()
{
    scene::Entity entity;
    scene::LightComponent light;
    scene_fixture::entity = &entity;
    const auto handle = scene_fixture::entity_handle;

    // Component ingress yields the owning entity's handle, never a component handle.
    uint64_t owner = 0;
    if (@LIGHT_OWNER@(&owner) != REFLGEN_PRSM_BINDING_INVALID_HANDLE || owner != 0) return 1; // no light yet
    entity.light = &light;
    if (@LIGHT_OWNER@(&owner) != 0 || owner != handle) return 2;
    if (@ENTITY_OWNER@(&owner) != 0 || owner != handle) return 3;

    float intensity = 0.0f;
    const auto lookups = scene_fixture::lookups;
    if (@LIGHT_GET@(handle, &intensity) != 0 || intensity != 2.0f) return 4;
    if (@LIGHT_SET@(handle, 5.5f) != 0 || light.GetIntensity() != 5.5f) return 5;
    // Every call resolves the component again; nothing is cached between calls.
    if (scene_fixture::lookups - lookups != 2) return 6;

    uint8_t enabled = 7;
    if (@ENTITY_GET@(handle, &enabled) != 0 || enabled != 1) return 7;
    if (@ENTITY_SET@(handle, 0) != 0 || entity.IsEnabled()) return 8;

    // Value records cross as their exact native bytes through pointers (D-042).
    thirdparty::vec3 position{};
    if (@POSITION_GET@(handle, &position) != 0 || position.x != 1.0f || position.y != 2.0f || position.z != 3.0f)
        return 20;
    const thirdparty::vec3 moved{4.0f, 5.0f, 6.0f};
    if (@POSITION_SET@(handle, &moved) != 0 || entity.position.z != 6.0f) return 21;
    if (@POSITION_SET@(handle, nullptr) != REFLGEN_PRSM_BINDING_INVALID_ARGUMENT) return 22;
    float sum = 0.0f;
    const thirdparty::vec3 delta{1.0f, 1.0f, 1.0f};
    if (@MOVE@(handle, &delta, 2.0f, &sum) != 0 || sum != 21.0f || entity.position.x != 6.0f) return 23;
    // Enumerations cross as case indices in declaration order: dim=0, off=1, bright=2.
    uint32_t shade = 99;
    if (@SHADE_GET@(handle, &shade) != 0 || shade != 0) return 24;
    if (@SHADE_SET@(handle, 2) != 0 || entity.shade != thirdparty::shade::bright) return 25;
    if (@SHADE_SET@(handle, 1) != 0 || entity.shade != thirdparty::shade::off) return 26;
    if (@SHADE_SET@(handle, 3) != REFLGEN_PRSM_BINDING_INVALID_ARGUMENT || entity.shade != thirdparty::shade::off)
        return 27;
    // A native value outside the selected cases is a failed result conversion; output untouched.
    entity.shade = static_cast<thirdparty::shade>(7);
    shade = 99;
    if (@SHADE_GET@(handle, &shade) != REFLGEN_PRSM_BINDING_NATIVE_FAILURE || shade != 99) return 28;
    entity.shade = thirdparty::shade::dim;

    // Removing the component makes the same entity handle fail closed for it only.
    entity.light = nullptr;
    intensity = -1.0f;
    if (@LIGHT_GET@(handle, &intensity) != REFLGEN_PRSM_BINDING_INVALID_HANDLE || intensity != -1.0f) return 9;
    if (@ENTITY_GET@(handle, &enabled) != 0 || enabled != 0) return 10;
    if (@LIGHT_GET@(handle + 1, &intensity) != REFLGEN_PRSM_BINDING_INVALID_HANDLE) return 11;
    scene_fixture::context = false;
    if (@ENTITY_GET@(handle, &enabled) != REFLGEN_PRSM_BINDING_INVALID_CONTEXT) return 12;
    return 0;
}
