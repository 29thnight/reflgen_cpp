expect_collision("${clang_arguments}" --clang-args-file "${clang_arguments}")
set(depfile "${WORK}/manifest.d")
file(WRITE "${depfile}" "dependency sentinel\n")
expect_collision("${depfile}" --depfile "${depfile}")
set(dependency_list "${WORK}/manifest.dependencies")
file(WRITE "${dependency_list}" "dependency list sentinel\n")
expect_collision("${dependency_list}" --dependency-list "${dependency_list}")

