# 선택적 JSON 선언 목록. 이 스크립트는 CTest 가 실행할 때만 생성기를 부른다.
# cmake -DGENERATOR=<reflgen> -DHEADER=<declarations_types.h> -DWORK=<dir> -P check_declarations.cmake
cmake_minimum_required(VERSION 3.25)

function(expect_json document expected)
    string(JSON actual ERROR_VARIABLE error GET "${document}" ${ARGN})
    if(error)
        message(FATAL_ERROR "cannot read JSON path '${ARGN}': ${error}\n${document}")
    endif()
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "JSON path '${ARGN}': expected '${expected}', got '${actual}'")
    endif()
endfunction()

function(expect_length document expected)
    string(JSON actual LENGTH "${document}" ${ARGN})
    if(NOT actual EQUAL expected)
        message(FATAL_ERROR "JSON path '${ARGN}': expected length ${expected}, got ${actual}")
    endif()
endfunction()

function(named_object output array name)
    string(JSON count LENGTH "${array}")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON candidate GET "${array}" ${index} name)
            if(candidate STREQUAL name)
                string(JSON object GET "${array}" ${index})
                set(${output} "${object}" PARENT_SCOPE)
                return()
            endif()
        endforeach()
    endif()
    message(FATAL_ERROR "no object named '${name}' in ${array}")
endfunction()

function(expect_source object text)
    expect_json("${object}" "${fixture}" source file)
    string(JSON line GET "${object}" source line)
    string(JSON column GET "${object}" source column)
    if(line LESS 1 OR column LESS 1)
        message(FATAL_ERROR "invalid source position for '${text}': ${object}")
    endif()
    file(READ "${fixture}" remaining)
    math(EXPR preceding_lines "${line} - 1")
    if(preceding_lines GREATER 0)
        foreach(index RANGE 1 ${preceding_lines})
            string(FIND "${remaining}" "\n" newline)
            if(newline EQUAL -1)
                message(FATAL_ERROR "source position lies after the end of ${fixture}: ${line}")
            endif()
            math(EXPR next_line "${newline} + 1")
            string(SUBSTRING "${remaining}" ${next_line} -1 remaining)
        endforeach()
    endif()
    string(REGEX MATCH "^[^\r\n]*" source_line "${remaining}")
    string(FIND "${source_line}" "${text}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "source line ${line} does not contain '${text}': ${source_line}")
    endif()
endfunction()

function(run_generator)
    execute_process(
        COMMAND "${GENERATOR}" --module manifest_test --output "${output_dir}"
                --attribute-scope declarations_tests ${ARGN} "${fixture}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE output)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "the generator failed:\n${output}")
    endif()
endfunction()

