# 충돌 실패는 원본·포함 header·기존 생성물을 보존한다.
function(expect_collision path)
    file(SHA256 "${path}" before)
    execute_process(
        COMMAND "${GENERATOR}" --module manifest_test --output "${output_dir}"
                --attribute-scope declarations_tests --declarations-json "${path}" ${ARGN} "${fixture}"
        RESULT_VARIABLE result
        OUTPUT_VARIABLE output
        ERROR_VARIABLE output)
    if(result EQUAL 0 OR NOT output MATCHES "RG0001: .*collides with input or generated file")
        message(FATAL_ERROR "the manifest path collision was not rejected for ${path}:\n${output}")
    endif()
    file(SHA256 "${path}" after)
    if(NOT before STREQUAL after)
        message(FATAL_ERROR "collision handling overwrote ${path}")
    endif()
endfunction()

expect_collision("${fixture}")
expect_collision("${dependency}")
foreach(name IN LISTS reflection_files)
    expect_collision("${output_dir}/${name}")
endforeach()
set(response "${WORK}/source/input.rsp")
