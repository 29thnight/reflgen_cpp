foreach(path IN LISTS unchanged_files)
    file(TIMESTAMP "${path}" stamp "%Y-%m-%dT%H:%M:%S" UTC)
    file(SHA256 "${path}" hash)
    set("stamp_${path}" "${stamp}")
    set("hash_${path}" "${hash}")
endforeach()
