    file(TIMESTAMP "${path}" stamp "%Y-%m-%dT%H:%M:%S" UTC)
    file(SHA256 "${path}" hash)
    if(NOT stamp STREQUAL "${stamp_${path}}" OR NOT hash STREQUAL "${hash_${path}}")
