# Exercise the installed-style CMake integration: compile ABI checks, regenerate,
# clean owned outputs, and refuse pre-existing user files.
cmake_minimum_required(VERSION 3.25)
foreach(name GENERATOR SOURCE WORK GENERATOR_NAME CXX_COMPILER MAKE_PROGRAM CONFIG)
    if(NOT DEFINED ${name})
        message(FATAL_ERROR "check_fsharp_table_cmake: ${name} is not set")
    endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/project")
file(WRITE "${WORK}/project/api.h" [=[
#pragma once
inline constexpr int ApiVersion = 46;
struct Api { int version, structSize; int (*Add)(int, int); };
using Binding [[reflgen::table("ScriptApi", "version", "structSize", ApiVersion)]] = Api;
]=])
file(WRITE "${WORK}/project/main.cpp" "#include \"api.h\"\nint fixture() { return ApiVersion; }\n")
file(WRITE "${WORK}/project/precompiled.h" "#pragma once\n#include <cstddef>\n")
set(project_text [=[
cmake_minimum_required(VERSION 3.25)
project(FSharpTableConsumer LANGUAGES CXX)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
include("@SOURCE@/cmake/reflgen.cmake")
add_library(consumer STATIC main.cpp)
target_include_directories(consumer PRIVATE "@SOURCE@/include")
target_compile_features(consumer PRIVATE cxx_std_20)
target_precompile_headers(consumer PRIVATE precompiled.h)
set_target_properties(consumer PROPERTIES UNITY_BUILD ON)
set(REFLGEN_EXECUTABLE "@GENERATOR@")
reflgen_generate(consumer MODULE native_consumer OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/generated"
    HEADERS api.h FSHARP_TABLE FSHARP_NAMESPACE Tests.CMake NO_REGISTRATION)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/binding-$<CONFIG>.txt" CONTENT
    "$<TARGET_GENEX_EVAL:consumer,$<TARGET_PROPERTY:consumer,REFLGEN_FSHARP_TABLE_SOURCE>>\n$<TARGET_GENEX_EVAL:consumer,$<TARGET_PROPERTY:consumer,REFLGEN_FSHARP_TABLE_MANIFEST>>\n")
]=])
string(CONFIGURE "${project_text}" project_text @ONLY)
file(WRITE "${WORK}/project/CMakeLists.txt" "${project_text}")
set(configure "${CMAKE_COMMAND}" -S "${WORK}/project" -B "${WORK}/build" -G "${GENERATOR_NAME}"
    "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}" "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}" "-DCMAKE_BUILD_TYPE=${CONFIG}")
execute_process(COMMAND ${configure} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "CMake consumer configure failed:\n${output}\n${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/build" --config "${CONFIG}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "CMake consumer ABI checks did not compile:\n${output}\n${error}")
endif()
set(base "${WORK}/build/generated/${CONFIG}/reflgen_native_consumer")
if(GENERATOR_NAME MATCHES "Ninja|Makefiles")
    file(READ "${WORK}/build/compile_commands.json" commands)
    string(JSON command_count LENGTH "${commands}")
    math(EXPR last_command "${command_count} - 1")
    set(saw_native FALSE)
    set(saw_unity FALSE)
    foreach(index RANGE 0 ${last_command})
        string(JSON source_file GET "${commands}" ${index} file)
        string(JSON command_line GET "${commands}" ${index} command)
        if(source_file MATCHES "reflgen_native_consumer_native.cpp$")
            set(saw_native TRUE)
            if(command_line MATCHES "cmake_pch")
                message(FATAL_ERROR "the generated ABI proof unexpectedly inherits the consumer PCH: ${command_line}")
            endif()
        endif()
        if(source_file MATCHES "unity_[^/]*[.]cxx$")
            set(saw_unity TRUE)
        endif()
    endforeach()
    if(NOT saw_native OR NOT saw_unity)
        message(FATAL_ERROR "the generated ABI proof was not compiled separately from the consumer unity batch")
    endif()
endif()
foreach(suffix _native.fs _native.cpp _native.json .optional.outputs)
    if(NOT EXISTS "${base}${suffix}")
        message(FATAL_ERROR "CMake consumer did not produce ${base}${suffix}")
    endif()
endforeach()
file(READ "${WORK}/build/binding-${CONFIG}.txt" paths)
if(NOT paths MATCHES "reflgen_native_consumer_native.fs" OR NOT paths MATCHES "reflgen_native_consumer_native.json")
    message(FATAL_ERROR "CMake did not expose native table target properties: ${paths}")
endif()
file(REMOVE "${base}_native.fs")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/build" --config "${CONFIG}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT EXISTS "${base}_native.fs")
    message(FATAL_ERROR "CMake did not regenerate a missing F# output:\n${output}\n${error}")
endif()
set(keep "${WORK}/build/generated/${CONFIG}/user-owned.txt")
file(WRITE "${keep}" "preserve this user file\n")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/build" --target clean --config "${CONFIG}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT EXISTS "${keep}")
    message(FATAL_ERROR "CMake clean did not preserve the unrelated file:\n${output}\n${error}")
endif()
foreach(suffix _native.fs _native.cpp _native.json .optional.outputs)
    if(EXISTS "${base}${suffix}")
        message(FATAL_ERROR "CMake clean retained owned output ${base}${suffix}")
    endif()
endforeach()
file(WRITE "${base}_native.fs" "user F# source\n")
execute_process(COMMAND ${configure} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "existing unowned optional output")
    message(FATAL_ERROR "CMake did not reject an unowned F# output:\n${output}\n${error}")
endif()
file(READ "${base}_native.fs" user_source)
if(NOT user_source STREQUAL "user F# source\n")
    message(FATAL_ERROR "CMake changed an unowned F# file")
endif()
message(STATUS "CMake F# table: ABI compilation, missing-output regeneration and ownership-aware clean passed")
