@PACKAGE_INIT@

set(REFLGEN_MODULE_SOURCE_DIRECTORY "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/reflgen/modules")

include("${CMAKE_CURRENT_LIST_DIR}/reflgen-targets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/reflgen.cmake")

# 함께 설치된 생성기가 있으면 reflgen_generate() 가 그것을 쓴다(cmake 설치는 bin/, vcpkg 는 tools/reflgen/).
if(NOT REFLGEN_EXECUTABLE)
    find_program(REFLGEN_EXECUTABLE reflgen
        HINTS "${PACKAGE_PREFIX_DIR}/bin" "${PACKAGE_PREFIX_DIR}/tools/reflgen"
        NO_DEFAULT_PATH)
endif()

if(NOT REFLGEN_IFC_EXECUTABLE)
    find_program(REFLGEN_IFC_EXECUTABLE reflgen-ifc
        HINTS "${PACKAGE_PREFIX_DIR}/bin" "${PACKAGE_PREFIX_DIR}/tools/reflgen"
        NO_DEFAULT_PATH)
endif()

check_required_components(reflgen)
