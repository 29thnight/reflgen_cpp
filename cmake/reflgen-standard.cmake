include(CheckCXXSourceCompiles)
include(CheckCXXCompilerFlag)

# Older CMake maps C++23 to /std:c++latest and decays C++26 to C++23. Probe the actual MSVC modes.
function(reflgen_configure_language_modes)
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC")
        return()
    endif()
    set(CMAKE_CXX_STANDARD "")
    set(CMAKE_CXX_STANDARD_REQUIRED OFF)
    check_cxx_compiler_flag("/std:c++23preview /WX" REFLGEN_MSVC_CPP23_PREVIEW)
    if(REFLGEN_MSVC_CPP23_PREVIEW)
        set(CMAKE_CXX23_STANDARD_COMPILE_OPTION /std:c++23preview PARENT_SCOPE)
        set(CMAKE_CXX23_EXTENSION_COMPILE_OPTION /std:c++23preview PARENT_SCOPE)
    endif()
    set(CMAKE_REQUIRED_FLAGS "/std:c++latest /EHsc /WX")
    check_cxx_source_compiles("#if !defined(_MSVC_LANG) || _MSVC_LANG < 202400L
#error C++26 language mode is unavailable
#endif
int main() {}" REFLGEN_MSVC_CPP26_MODE)
    if(REFLGEN_MSVC_CPP26_MODE)
        set(CMAKE_CXX26_STANDARD_COMPILE_OPTION /std:c++latest PARENT_SCOPE)
        set(CMAKE_CXX26_EXTENSION_COMPILE_OPTION /std:c++latest PARENT_SCOPE)
        # Advertise only the compile-proven language mode; reflection still has its separate backend probe.
        set(features ${CMAKE_CXX_COMPILE_FEATURES} cxx_std_26)
        list(REMOVE_DUPLICATES features)
        set(CMAKE_CXX_COMPILE_FEATURES "${features}" PARENT_SCOPE)
        set(CMAKE_CXX26_COMPILE_FEATURES cxx_std_26 PARENT_SCOPE)
    endif()
endfunction()

# Probe the exact backend, including annotations, member splicing and static strings. No version guessing.
function(reflgen_detect_standard output)
    # Use the explicit probe flags below; do not let an older CMake silently append -std=c++23.
    set(CMAKE_CXX_STANDARD "")
    set(CMAKE_CXX_STANDARD_REQUIRED OFF)
    if(EXISTS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include/reflgen/generated.h")
        set(CMAKE_REQUIRED_INCLUDES "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include")
    else()
        set(CMAKE_REQUIRED_INCLUDES "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../include")
    endif()
    set(CMAKE_REQUIRED_DEFINITIONS -DREFLGEN_USE_STD_REFLECTION=1)
    if(MSVC)
        set(CMAKE_REQUIRED_FLAGS "/std:c++latest /EHsc /utf-8")
    else()
        set(CMAKE_REQUIRED_FLAGS "-std=c++26")
        if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
            string(APPEND CMAKE_REQUIRED_FLAGS " -freflection")
        endif()
    endif()
    check_cxx_source_compiles("#include <reflgen/generated.h>
struct [[=reflgen::reflect(\"probe\")]] probe {
 [[=reflgen::ignore{}]] int omitted;
 [[=reflgen::serialized_name(\"v\")]] int value;
};
static_assert(reflgen::field_count<probe>() == 1);
static_assert(reflgen::schema_of<probe>.name == \"probe\");
int main() {}" REFLGEN_STANDARD_BACKEND_COMPILES)
    set(${output} ${REFLGEN_STANDARD_BACKEND_COMPILES} PARENT_SCOPE)
endfunction()

# AUTO only enables standard reflection for a target already requesting C++26. LEGACY is an explicit opt-out.
function(reflgen_select_backend target requested output)
    string(TOUPPER "${requested}" requested)
    if(NOT requested)
        set(requested AUTO)
    endif()
    if(NOT requested MATCHES "^(AUTO|STD|LEGACY)$")
        message(FATAL_ERROR "reflgen backend must be AUTO, STD or LEGACY")
    endif()
    get_target_property(standard ${target} CXX_STANDARD)
    get_target_property(features ${target} COMPILE_FEATURES)
    set(selected LEGACY)
    if(requested STREQUAL "STD" OR (requested STREQUAL "AUTO" AND
       (standard GREATER_EQUAL 26 OR "cxx_std_26" IN_LIST features)))
        reflgen_detect_standard(available)
        if(available)
            set(selected STD)
        elseif(requested STREQUAL "STD")
            message(FATAL_ERROR "reflgen STD backend failed its compiler/library feature probe; use AUTO or LEGACY")
        endif()
    endif()
    if(selected STREQUAL "STD")
        target_compile_features(${target} PUBLIC cxx_std_26)
        if(CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
            target_compile_options(${target} PUBLIC -freflection)
        endif()
        target_compile_definitions(${target} PUBLIC REFLGEN_USE_STD_REFLECTION=1)
    else()
        target_compile_definitions(${target} PUBLIC REFLGEN_USE_STD_REFLECTION=0)
    endif()
    set_property(TARGET ${target} PROPERTY REFLGEN_SELECTED_BACKEND ${selected})
    set(${output} ${selected} PARENT_SCOPE)
endfunction()

# Standard reflection supplies schemas in the compiler. Only the explicit registration manifest is generated.
function(reflgen_generate_standard target)
    if(POLICY CMP0174)
        cmake_policy(SET CMP0174 NEW)
    endif()
    cmake_parse_arguments(PARSE_ARGV 1 ARG "NO_REGISTRATION" "MODULE;OUTPUT_DIRECTORY" "HEADERS;REGISTRATION_HEADERS;TYPES;IMPORTS")
    if(NOT ARG_MODULE)
        set(ARG_MODULE ${target})
    endif()
    string(MAKE_C_IDENTIFIER "${ARG_MODULE}" module)
    if(NOT ARG_OUTPUT_DIRECTORY)
        set(ARG_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/reflgen/${target}")
    endif()
    set(header "${ARG_OUTPUT_DIRECTORY}/reflgen_${module}.h")
    set(source "${ARG_OUTPUT_DIRECTORY}/reflgen_${module}.cpp")
    set(text "// <auto-generated/> Generated by reflgen standard backend.\n#pragma once\n")
    foreach(name IN LISTS ARG_IMPORTS)
        string(APPEND text "import ${name};\n")
    endforeach()
    string(APPEND text "namespace reflgen { class registry; namespace generated { void register_${module}(registry&); void register_${module}(); } }\n")
    file(CONFIGURE OUTPUT "${header}" CONTENT "${text}" @ONLY)
    set(text "#include <reflgen/runtime/registry.h>\n")
    foreach(file IN LISTS ARG_HEADERS)
        get_filename_component(file "${file}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        string(APPEND text "#include \"${file}\"\n")
    endforeach()
    foreach(name IN LISTS ARG_IMPORTS)
        string(APPEND text "import ${name};\n")
    endforeach()
    string(APPEND text "#include \"reflgen_${module}.h\"\n")
    foreach(file IN LISTS ARG_REGISTRATION_HEADERS)
        get_filename_component(file "${file}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        string(APPEND text "#include \"${file}\"\n")
    endforeach()
    string(APPEND text "void reflgen::generated::register_${module}(registry& registry) {\n")
    foreach(type IN LISTS ARG_TYPES)
        string(APPEND text "registry.add<${type}>();\n")
    endforeach()
    string(APPEND text "}\nvoid reflgen::generated::register_${module}() { register_${module}(default_registry()); }\n")
    file(CONFIGURE OUTPUT "${source}" CONTENT "${text}" @ONLY)
    target_include_directories(${target} PUBLIC "${ARG_OUTPUT_DIRECTORY}")
    if(ARG_IMPORTS)
        set_target_properties(${target} PROPERTIES CXX_SCAN_FOR_MODULES ON)
    endif()
    if(NOT ARG_NO_REGISTRATION)
        if(NOT ARG_TYPES)
            message(FATAL_ERROR "STD registration requires TYPES (explicit class manifest); or use NO_REGISTRATION")
        endif()
        target_sources(${target} PRIVATE "${source}")
    endif()
endfunction()

